rules_version = '2';

// =========================================================================
// Moto Świry Toruń — zasady bezpieczeństwa Cloud Firestore
//
// Wdrożenie (raz, z katalogu repo):
//   firebase deploy --only firestore:rules
// albo wklej tę treść w konsoli Firebase → Firestore → Rules → Publish.
//
// Model danych:
//   users/{uid}   — profil: name, bike, email, score, createdAt
//   routes/{id}   — trasa: title, description, region, difficulty, surface,
//                   authorId, authorName, authorBike, start, end, waypoints,
//                   path, distanceKm, durationSec, rideDate, meetingPoint,
//                   likes[], participants[], comments[], suggestions[], createdAt
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // --- Profile użytkowników -------------------------------------------
    match /users/{uid} {
      // Ranking jest publiczny (goście też widzą tabelę).
      allow read: if true;

      // Każdy tworzy i edytuje tylko swój profil.
      allow create: if isSelf(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40;

      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'bike', 'score', 'email', 'createdAt']);

      allow delete: if isSelf(uid);
    }

    // --- Trasy społeczności ---------------------------------------------
    match /routes/{routeId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 80
        && request.resource.data.description.size() <= 900
        && request.resource.data.distanceKm is number
        && request.resource.data.likes == []
        && request.resource.data.participants == [];

      // Autor może wszystko, pozostali tylko dołączają do tablic:
      // participants (udział), likes (polubienia), comments, suggestions.
      allow update: if isSelf(resource.data.authorId)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['participants', 'likes', 'comments', 'suggestions']));

      allow delete: if isSelf(resource.data.authorId);
    }

    // Wszystko inne — zamknięte.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
